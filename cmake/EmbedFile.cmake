# `cmake -P` script: turns a binary file into a C++ source with a byte array.
# Parameters: INPUT, OUTPUT, SYMBOL.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "EmbedFile.cmake: INPUT, OUTPUT, SYMBOL are required")
endif()

file(READ "${INPUT}" HEX_CONTENT HEX)
file(SIZE "${INPUT}" BYTE_COUNT)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_CONTENT}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" BYTES "${BYTES}")

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedFile.cmake from ${INPUT}. Do not edit.\n"
"#include <cstddef>\n"
"#include <cstdint>\n"
"extern const std::uint8_t ${SYMBOL}[] = {\n${BYTES}0x00\n};\n"
"extern const std::size_t ${SYMBOL}_size = ${BYTE_COUNT};\n")
