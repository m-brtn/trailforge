# `cmake -P` script: embeds the traced vehicle blueprints (assets/vehicles/<id>/blueprint.json) into one C++ source
# with the table declared in src/vehicle/VehicleBlueprint.cpp. Parameters: IDS (comma-separated), SRC_DIR, OUTPUT.
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED IDS OR NOT DEFINED SRC_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "EmbedBlueprints.cmake: IDS, SRC_DIR, OUTPUT are required")
endif()
string(REPLACE "," ";" IDS "${IDS}")

set(_arrays "")
set(_rows "")
foreach(id IN LISTS IDS)
    set(_file ${SRC_DIR}/assets/vehicles/${id}/blueprint.json)
    file(READ "${_file}" _hex HEX)
    file(SIZE "${_file}" _size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" _bytes "${_bytes}")
    string(APPEND _arrays "const std::uint8_t k_${id}[] = {\n${_bytes}0x00};\n")
    string(APPEND _rows "    {\"${id}\", k_${id}, ${_size}},\n")
endforeach()
list(LENGTH IDS _count)

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedBlueprints.cmake from assets/vehicles/<id>/blueprint.json. Do not edit.\n"
"#include <cstddef>\n#include <cstdint>\n\n"
"namespace {\n${_arrays}} // namespace\n\n"
"namespace tf {\n"
"struct EmbeddedBlueprint {\n    const char* id;\n    const std::uint8_t* data;\n    std::size_t size;\n};\n"
"extern const EmbeddedBlueprint g_embeddedBlueprints[];\n"
"extern const std::size_t g_embeddedBlueprintCount;\n"
"const EmbeddedBlueprint g_embeddedBlueprints[] = {\n${_rows}};\n"
"const std::size_t g_embeddedBlueprintCount = ${_count};\n"
"} // namespace tf\n")
