# `cmake -P` script: embeds the compiled shader blobs into one C++ source with the table declared in
# src/render/ShaderBlobs.h. Parameters: ENTRIES and FORMATS (comma-separated), GEN_DIR, OUTPUT.
# Formats: spirv (<entry>.spv), msl (<entry>.msl), metallib (<entry>.metallib), dxil (<entry>.dxil).
cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED ENTRIES OR NOT DEFINED FORMATS OR NOT DEFINED GEN_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "EmbedShaders.cmake: ENTRIES, FORMATS, GEN_DIR, OUTPUT are required")
endif()
string(REPLACE "," ";" ENTRIES "${ENTRIES}")
string(REPLACE "," ";" FORMATS "${FORMATS}")
set(_ext_spirv spv)
set(_ext_msl msl)
set(_ext_metallib metallib)
set(_ext_dxil dxil)

set(_arrays "")
set(_rows "")
foreach(entry IN LISTS ENTRIES)
    set(_row "    {\"${entry}\"")
    foreach(fmt spirv msl metallib dxil)
        if(fmt IN_LIST FORMATS)
            set(_file ${GEN_DIR}/${entry}.${_ext_${fmt}})
            file(READ "${_file}" _hex HEX)
            file(SIZE "${_file}" _size)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
            string(REGEX REPLACE "((0x..,){32})" "\\1\n" _bytes "${_bytes}")
            # A trailing zero keeps text formats (MSL) NUL-terminated; it is not counted in the size.
            string(APPEND _arrays "const std::uint8_t k_${entry}_${fmt}[] = {\n${_bytes}0x00};\n")
            string(APPEND _row ", {k_${entry}_${fmt}, ${_size}}")
        else()
            string(APPEND _row ", {nullptr, 0}")
        endif()
    endforeach()
    string(APPEND _rows "${_row}},\n")
endforeach()
list(LENGTH ENTRIES _count)

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedShaders.cmake from shaders/scene.hlsl. Do not edit.\n"
"#include \"render/ShaderBlobs.h\"\n\n"
"namespace {\n${_arrays}} // namespace\n\n"
"namespace tf {\n"
"const ShaderBlob g_shaderBlobs[] = {\n${_rows}};\n"
"const std::size_t g_shaderBlobCount = ${_count};\n"
"} // namespace tf\n")
