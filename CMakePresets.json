{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TRAILFORGE_BUILD_APP": "ON",
        "TRAILFORGE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "headless",
      "displayName": "Headless (physics and tests, no SDL/ImGui)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TRAILFORGE_BUILD_APP": "OFF"
      }
    },
    {
      "name": "host-tools",
      "displayName": "macOS host tools for cross builds (the engine's quench_shaderc only)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "TRAILFORGE_BUILD_TESTS": "OFF" }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "TRAILFORGE_BUILD_TESTS": "OFF",
        "QUENCH_HOST_SHADERC": "${sourceDir}/build/host-tools/_deps/quench-build/quench_shaderc"
      }
    },
    {
      "name": "ios-sim-release",
      "displayName": "iOS Simulator Release (arm64, iOS 26+, run build/host-tools first)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    },
    {
      "name": "ios-device-release",
      "displayName": "iOS device Release (arm64, iOS 26+, needs signing to install)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_SYSROOT": "iphoneos" }
    },
    {
      "name": "ios-xcode",
      "displayName": "iOS device Xcode project (build/ios-xcode/TrailForge.xcodeproj, Automatic signing, run build/host-tools first)",
      "inherits": "ios-base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_XCODE_GENERATE_SCHEME": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC x64 + Ninja, from an x64 Native Tools prompt)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (MSVC x64 + Ninja, from an x64 Native Tools prompt)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja, system gcc/clang)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (Ninja, system gcc/clang)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "host-tools", "configurePreset": "host-tools", "targets": ["quench_shaderc"] },
    { "name": "ios-sim-release", "configurePreset": "ios-sim-release" },
    { "name": "ios-device-release", "configurePreset": "ios-device-release" },
    {
      "name": "ios-xcode",
      "configurePreset": "ios-xcode",
      "configuration": "Release",
      "targets": ["trailforge"],
      "nativeToolOptions": ["-allowProvisioningUpdates"]
    },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } }
  ]
}
